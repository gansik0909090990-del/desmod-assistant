<Window x:Class="DesmodAssistant.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Desmod Assistant" Height="780" Width="1240" MinHeight="680" MinWidth="1040"
 WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#0A0D16"
 FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" CornerRadius="18" GlassFrameThickness="0" ResizeBorderThickness="7"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="NavButton" TargetType="Button">
   <Setter Property="Height" Value="48"/><Setter Property="Margin" Value="0,5"/><Setter Property="Padding" Value="18,0"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Foreground" Value="#C5CCDA"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="15"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="12"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#22FFFFFF"/></Trigger><Trigger Property="Tag" Value="Active"><Setter TargetName="Root" Property="Background" Value="#337C5CFF"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button">
   <Setter Property="Padding" Value="22,12"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.86"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Field" TargetType="TextBox"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#181E2D"/><Setter Property="BorderBrush" Value="#33405B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,11"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="#EAF0FF"/><Setter Property="Background" Value="#111827"/><Setter Property="Padding" Value="12,9"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#34305B"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#7C5CFF"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#EAF0FF"/><Setter Property="Background" Value="#151D2C"/><Setter Property="BorderBrush" Value="#3A4660"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,0"/><Setter Property="Height" Value="40"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ToggleBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" TextElement.Foreground="#EAF0FF"/><TextBlock Grid.Column="1" Text="▾" Foreground="#AAB3C5" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#7C5CFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300" Background="#111827" BorderBrush="#46536D" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="HasItems" Value="False"><Setter TargetName="Popup" Property="MinHeight" Value="40"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,7"/></Style>
 </Window.Resources>
 <Grid x:Name="RootGrid" Opacity="0">
  <Image x:Name="BackgroundImage" Stretch="UniformToFill" Opacity="0.42"/>
  <MediaElement x:Name="BackgroundVideo" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="UniformToFill" Opacity="0.4" IsMuted="True" MediaEnded="BackgroundVideo_OnMediaEnded"/>
  <Rectangle x:Name="ThemeOverlay"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F20A0D16" Offset="0"/><GradientStop Color="#DC151A2A" Offset="0.55"/><GradientStop Color="#F1080A11" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Grid.Row="0" Background="#7A090C14" BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
    <Grid Margin="20,0,10,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="30" Height="30" CornerRadius="10" Background="{StaticResource AccentBrush}"><TextBlock Text="D" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="DESMOD ASSISTANT" Margin="11,0,0,0" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/><Border Margin="14,0,0,0" Padding="9,4" CornerRadius="9" Background="#1AFFFFFF"><TextBlock x:Name="TopStatusText" Text="Инициализация" FontSize="11" Foreground="{StaticResource MutedBrush}"/></Border></StackPanel>
     <Button Grid.Column="1" Content="—" Width="42" Height="36" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="18" Click="Minimize_OnClick"/><Button Grid.Column="2" Content="×" Width="42" Height="36" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="20" Click="Close_OnClick"/>
    </Grid>
   </Border>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#980B0E18" BorderBrush="#22FFFFFF" BorderThickness="0,0,1,0"><Grid Margin="16,22"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="НАВИГАЦИЯ" FontSize="10" Foreground="#6F7B91" FontWeight="SemiBold" Margin="18,0,0,10"/><Button x:Name="HomeNav" Style="{StaticResource NavButton}" Tag="Active" Content="◉   Ассистент" Click="HomeNav_OnClick"/><Button x:Name="CommandsNav" Style="{StaticResource NavButton}" Content="⌘   Команды" Click="CommandsNav_OnClick"/><Button x:Name="SupportNav" Style="{StaticResource NavButton}" Content="?   Нужна помощь" Click="SupportNav_OnClick"/><Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Content="⚙   Настройки" Click="SettingsNav_OnClick"/></StackPanel><StackPanel Grid.Row="1"><Border Background="#14FFFFFF" CornerRadius="14" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock Text="КОДОВОЕ СЛОВО" FontSize="10" Foreground="#7F8BA1"/><TextBlock x:Name="WakeWordPreview" Text="«Помощник»" Margin="0,5,0,0" FontWeight="SemiBold"/></StackPanel></Border><TextBlock Text="v1.1 · by Desmod.G" Foreground="#566176" FontSize="11" HorizontalAlignment="Center"/></StackPanel></Grid></Border>
    <TabControl x:Name="MainTabs" Grid.Column="1" SelectedIndex="0" Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0" Padding="0"><TabControl.ItemsPanel><ItemsPanelTemplate><StackPanel Height="0"/></ItemsPanelTemplate></TabControl.ItemsPanel><TabControl.ItemContainerStyle><Style TargetType="TabItem"><Setter Property="Width" Value="0"/><Setter Property="Height" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Opacity" Value="0"/><Setter Property="IsTabStop" Value="False"/></Style></TabControl.ItemContainerStyle>
     <TabItem><Grid Margin="36,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Добро пожаловать" Foreground="{StaticResource TextBrush}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Говорите свободно — ассистент слушает постоянно и показывает распознанный текст ниже." Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,7,0,0"/></StackPanel><Grid Grid.Row="1"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Grid Width="240" Height="240"><Ellipse Fill="#127C5CFF" Stroke="#447C5CFF" StrokeThickness="2"/><Ellipse Width="164" Height="164" Fill="#277C5CFF" Stroke="#887C5CFF" StrokeThickness="2"/><Ellipse x:Name="AssistantOrb" Width="98" Height="98" Fill="{StaticResource AccentBrush}" IsHitTestVisible="False"/><TextBlock Text="D" Foreground="White" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid><TextBlock x:Name="ListeningTitle" Text="Подключаю микрофон" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,0"/><TextBlock x:Name="TranscriptText" Text="После заставки микрофон включится автоматически" TextWrapping="Wrap" TextAlignment="Center" Width="560" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,8,0,0"/></StackPanel></Grid><Border Grid.Row="2" Background="#E5101522" BorderBrush="#27344C" BorderThickness="1" CornerRadius="16" Padding="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="CommandInput" Background="Transparent" BorderThickness="0" Foreground="White" Padding="12,10" FontSize="15" KeyDown="CommandInput_OnKeyDown" ToolTip="Здесь появляется ваша речь; команду также можно ввести вручную"/><Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Выполнить" Click="ExecuteCommand_OnClick"/></Grid></Border></Grid></TabItem>
     <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="36,28"><TextBlock Text="Команды" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Примеры фраз, которые ассистент понимает без подключения ИИ." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,24"/><UniformGrid Columns="2"><Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="20" Margin="0,0,10,10"><StackPanel><TextBlock Text="Видео и сайты" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="«Помощник, открой YouTube»&#x0a;«Открой сайт github.com»&#x0a;«Найди канал Димы Масленникова»" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" LineHeight="24"/></StackPanel></Border><Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="20" Margin="10,0,0,10"><StackPanel><TextBlock Text="Игры и приложения" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="«Помощник, открой Доту»&#x0a;«Запусти Steam»&#x0a;«Открой CapCut / TLauncher»" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" LineHeight="24"/></StackPanel></Border><Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="20" Margin="0,10,10,0"><StackPanel><TextBlock Text="Экран" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="«Сделай скриншот»&#x0a;«Запусти запись экрана»&#x0a;NVIDIA: Alt + F9" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" LineHeight="24"/></StackPanel></Border><Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="20" Margin="10,10,0,0"><StackPanel><TextBlock Text="Свободный диалог" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="Подключите API-ключ во вкладке настроек, чтобы задавать вопросы свободными фразами." Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="24"/></StackPanel></Border></UniformGrid></StackPanel></ScrollViewer></TabItem>
     <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="36,28" MaxWidth="900" HorizontalAlignment="Left" TextElement.Foreground="White"><TextBlock Text="Нужна помощь" Foreground="White" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Войдите через Google, создайте обращение и следите за ответом поддержки." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,24"/>
      <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="22" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition MinWidth="280"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,24,0"><TextBlock x:Name="AccountTitle" Text="Вы не вошли" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="AccountDetails" Text="Google-аккаунт нужен для личных обращений и ролей." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel><Button x:Name="GoogleLoginButton" Grid.Column="1" Content="Войти через Google" Style="{StaticResource PrimaryButton}" MinWidth="168" VerticalAlignment="Center" Click="GoogleLogin_OnClick"/></Grid></Border>
      <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="22" Margin="0,0,0,14"><StackPanel><TextBlock Text="Новое обращение" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Тема" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,6"/><TextBox x:Name="TicketSubjectInput" Style="{StaticResource Field}"/><TextBlock Text="Опишите проблему" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,6"/><TextBox x:Name="TicketDescriptionInput" Style="{StaticResource Field}" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><Button Content="Отправить обращение" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="SubmitTicket_OnClick"/></StackPanel></Border>
      <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="22" Margin="0,0,0,14"><StackPanel><TextBlock Text="Мои обращения" FontSize="18" FontWeight="SemiBold"/><ListBox x:Name="TicketsList" Margin="0,12,0,0" MinHeight="120" Background="#181E2D" Foreground="White" BorderBrush="#33405B"/></StackPanel></Border>
      <Border x:Name="AdminPanel" Background="#E3191730" BorderBrush="#667C5CFF" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,0,30" Visibility="Collapsed"><StackPanel><TextBlock Text="Панель управления" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Роли пользователей и обработка обращений." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,14"/><TextBlock Text="Email пользователя" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="RoleEmailInput" Style="{StaticResource Field}" Margin="0,6,0,10"/><StackPanel Orientation="Horizontal"><Button Content="Выдать модератора" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="GrantModerator_OnClick"/><Button Content="Выдать администратора" Style="{StaticResource PrimaryButton}" Click="GrantAdmin_OnClick"/></StackPanel><Separator Margin="0,20" Background="#33405B"/><TextBlock Text="Ответ на выбранное обращение" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="ModeratorReplyInput" Style="{StaticResource Field}" Height="90" Margin="0,6,0,10" AcceptsReturn="True" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal"><Button Content="Отправить ответ" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="ReplyTicket_OnClick"/><Button Content="Закрыть обращение" Style="{StaticResource PrimaryButton}" Click="CloseTicket_OnClick"/></StackPanel></StackPanel></Border>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="36,28" MaxWidth="820" HorizontalAlignment="Left"><TextBlock Text="Настройки" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Изменения применяются после сохранения." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,24"/>
      <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="22" Margin="0,0,0,14"><StackPanel><TextBlock Text="Микрофон и активация" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Ассистент выполняет команды молча и показывает результат текстом." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,14"/><TextBlock Text="Микрофон" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/><ComboBox x:Name="MicrophoneCombo" Height="40" Background="#181E2D" Foreground="White"/><ProgressBar x:Name="MicrophoneLevel" Height="5" Minimum="0" Maximum="1" Margin="0,8,0,0" Foreground="{StaticResource AccentBrush}" Background="#20283A"/><Button Content="Проверить микрофон" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,10,0,4" Click="TestMicrophone_OnClick"/><TextBlock Text="Кодовое слово" Foreground="{StaticResource MutedBrush}" Margin="0,15,0,6"/><TextBox x:Name="WakeWordInput" Style="{StaticResource Field}"/><CheckBox x:Name="ContinuousListeningCheck" Content="Постоянно слушать кодовое слово"/></StackPanel></Border>
      <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="22" Margin="0,0,0,14"><StackPanel><TextBlock Text="Внешний вид" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Тема" Foreground="{StaticResource MutedBrush}" Margin="0,15,0,6"/><ComboBox x:Name="ThemeCombo" Height="40" Background="#181E2D" Foreground="White"><ComboBoxItem Content="Тёмная" Tag="Dark"/><ComboBoxItem Content="Светлая" Tag="Light"/></ComboBox><TextBlock Text="Собственный фон: PNG, JPG, GIF или MP4" Foreground="{StaticResource MutedBrush}" Margin="0,15,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="BackgroundPathInput" Style="{StaticResource Field}" IsReadOnly="True"/><Button Grid.Column="1" Content="Выбрать" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="ChooseBackground_OnClick"/></Grid></StackPanel></Border>
      <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="22" Margin="0,0,0,14"><StackPanel><TextBlock Text="ИИ для свободных запросов" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="API-ключ хранится только локально в профиле Windows." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,14"/><TextBlock Text="API endpoint" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/><TextBox x:Name="EndpointInput" Style="{StaticResource Field}"/><TextBlock Text="Модель" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,6"/><TextBox x:Name="ModelInput" Style="{StaticResource Field}"/><TextBlock Text="API-ключ" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,6"/><PasswordBox x:Name="ApiKeyInput" Background="#181E2D" Foreground="White" BorderBrush="#33405B" Padding="14,11"/></StackPanel></Border>
      <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="22" Margin="0,0,0,14"><StackPanel><TextBlock Text="Поддержка" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Вход через Google выполняется одной кнопкой в разделе поддержки." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,14"/><TextBlock Text="Адрес сервера поддержки (необязательно; без него обращения хранятся локально)" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/><TextBox x:Name="SupportBackendInput" Style="{StaticResource Field}"/></StackPanel></Border>
      <CheckBox x:Name="ConfirmSensitiveCheck" Content="Всегда спрашивать подтверждение перед выключением или перезагрузкой"/><CheckBox x:Name="LaunchAtStartupCheck" Content="Запускать вместе с Windows"/><Button Content="Сохранить настройки" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,30" Click="SaveSettings_OnClick"/>
     </StackPanel></ScrollViewer></TabItem>
    </TabControl>
   </Grid>
  </Grid>
  <Grid x:Name="IntroOverlay" Background="#F2070910" Panel.ZIndex="20"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="760"><TextBlock x:Name="IntroTitle" Text="" FontSize="54" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="IntroSignature" Text="" Foreground="{StaticResource AccentLightBrush}" FontSize="21" FontStyle="Italic" TextAlignment="Center" Margin="0,12,0,0"/><TextBlock Text="Твой голос. Твои правила. Твой компьютер." Foreground="#8F9AAE" FontSize="15" TextAlignment="Center" Margin="0,16,0,0"/><Button x:Name="ContinueButton" Content="Продолжить" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,34,0,0" Opacity="0" IsEnabled="False" Click="ContinueButton_OnClick"/></StackPanel></Grid>
  <Border x:Name="ConfirmOverlay" Background="#D9000000" Visibility="Collapsed" Panel.ZIndex="30"><Border Background="#151A28" BorderBrush="#3D4963" BorderThickness="1" CornerRadius="18" Padding="26" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="Требуется подтверждение" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="ConfirmMessage" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,22"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Отмена" Padding="20,11" Background="#253047" Foreground="White" BorderThickness="0" Margin="0,0,10,0" Click="CancelConfirm_OnClick"/><Button Content="Подтвердить" Style="{StaticResource PrimaryButton}" Click="AcceptConfirm_OnClick"/></StackPanel></StackPanel></Border></Border>
 </Grid>
</Window>
