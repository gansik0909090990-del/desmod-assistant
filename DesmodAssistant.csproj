<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Desmod.Assistant</AssemblyName>
    <RootNamespace>DesmodAssistant</RootNamespace>
    <Version>1.1.5</Version>
    <DefaultItemExcludes>$(DefaultItemExcludes);publish\**;release\**;artifacts\**;model-cache\**</DefaultItemExcludes>
    <GoogleOAuthClientId>675488933296-8b4rh2lndbfcjfpun01fe2ub20kvctbu.apps.googleusercontent.com</GoogleOAuthClientId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="Vosk" Version="0.3.38" />
  </ItemGroup>

  <ItemGroup Condition="Exists('SpeechModels')">
    <Content Include="SpeechModels\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GoogleOAuthClientId</_Parameter1>
      <_Parameter2>$(GoogleOAuthClientId)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
